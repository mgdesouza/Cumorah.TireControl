@{
    var isLogin = ViewContext.RouteData.Values["page"]?.ToString() == "/Login";
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | TireControl</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.9.1/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isLogin ? "login-page" : "layout-fixed sidebar-expand-lg bg-body-tertiary")">
@if (isLogin)
{
    @RenderBody()
}
else
{
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                <a class="nav-link sidebar-toggler" href="#" data-lte-toggle="sidebar" role="button" aria-label="Alternar menu">
                    <i class="bi bi-list"></i>
                </a>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="#" aria-label="Notificações">
                            <i class="bi bi-bell"></i><span class="notification-dot"></span>
                        </a>
                    </li>
                    <li class="nav-item dropdown ms-2">
                        <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="dropdown" href="#" aria-expanded="false">
                            <span class="user-avatar">AM</span>
                            <span class="d-none d-sm-inline fw-semibold small">Administração</span>
                            <i class="bi bi-chevron-down small"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" asp-page="/Login"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-tirecontrol shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-page="/Index" class="brand-link">
                    <span class="brand-symbol"><i class="bi bi-circle-fill"></i></span>
                    <span class="brand-text">Tire<span>Control</span></span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-3">
                    <ul class="nav sidebar-menu flex-column" role="menu">
                        <li class="nav-header">MENU PRINCIPAL</li>
                        <li class="nav-item">
                            <a asp-page="/Index" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                                <i class="nav-icon bi bi-grid-1x2"></i><p>Visão geral</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon bi bi-disc"></i><p>Pneus</p></a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon bi bi-truck"></i><p>Frota</p></a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon bi bi-clipboard2-check"></i><p>Inspeções <span class="nav-badge">3</span></p></a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon bi bi-bar-chart-line"></i><p>Relatórios</p></a>
                        </li>
                        <li class="nav-header mt-3">CONFIGURAÇÕES</li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon bi bi-gear"></i><p>Configurações</p></a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="support-icon"><i class="bi bi-question-circle"></i></div>
                <div><strong>Precisa de ajuda?</strong><a href="mailto:suporte@tirecontrol.com">Fale com o suporte</a></div>
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer bg-white border-top">
            <span>© @DateTime.Now.Year TireControl.</span>
            <span class="float-end d-none d-sm-inline">Gestão que move sua operação.</span>
        </footer>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.9.1/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
