<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | TireControl</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Login" ? "login-body" : "")">
    @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Login")
    {
        <header class="site-header">
            <a class="brand" asp-page="/Index"><span class="brand__mark">TC</span><span>Tire<span>Control</span></span></a>
            <nav aria-label="Navegação principal"><a href="#recursos">Recursos</a><a href="#recursos">Sobre nós</a><a href="mailto:suporte@tirecontrol.com">Suporte</a></nav>
            <a class="header-login" asp-page="/Login">Entrar <span aria-hidden="true">→</span></a>
        </header>
    }
    <main>@RenderBody()</main>
    @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Login")
    {
        <footer class="site-footer"><span>© @DateTime.Now.Year TireControl. Gestão que move sua operação.</span><a asp-page="/Login">Acessar plataforma →</a></footer>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
