@page
@model IndexModel
@{ ViewData["Title"] = "Visão geral"; }

<div class="content-header py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3"><div><p class="page-kicker">PAINEL DE CONTROLE</p><h1 class="page-title">Olá, Administração <span>👋</span></h1><p class="page-subtitle mb-0">Acompanhe a performance da sua operação hoje.</p></div><button class="btn btn-tirecontrol"><i class="bi bi-plus-lg me-2"></i>Nova inspeção</button></div>
</div>

<section class="row g-4 mb-4" aria-label="Indicadores da frota">
    <div class="col-sm-6 col-xl-3"><article class="metric-card"><div><p>Pneus em operação</p><h2>1.248</h2><span class="metric-up"><i class="bi bi-arrow-up"></i> 8,4% <small>vs. mês anterior</small></span></div><span class="metric-icon icon-lime"><i class="bi bi-disc"></i></span></article></div>
    <div class="col-sm-6 col-xl-3"><article class="metric-card"><div><p>Vida útil média</p><h2>74<small>%</small></h2><span class="metric-up"><i class="bi bi-arrow-up"></i> 3,1% <small>vs. mês anterior</small></span></div><span class="metric-icon icon-blue"><i class="bi bi-activity"></i></span></article></div>
    <div class="col-sm-6 col-xl-3"><article class="metric-card"><div><p>Inspeções pendentes</p><h2>03</h2><span class="metric-warning"><i class="bi bi-exclamation-circle"></i> Requer atenção</span></div><span class="metric-icon icon-orange"><i class="bi bi-clipboard2-check"></i></span></article></div>
    <div class="col-sm-6 col-xl-3"><article class="metric-card"><div><p>Economia no mês</p><h2>R$ 18,4<small>k</small></h2><span class="metric-up"><i class="bi bi-arrow-up"></i> 12,5% <small>vs. mês anterior</small></span></div><span class="metric-icon icon-purple"><i class="bi bi-wallet2"></i></span></article></div>
</section>

<section class="row g-4"><div class="col-xl-8"><article class="card dashboard-card h-100"><header class="card-header bg-white border-0 d-flex align-items-center justify-content-between"><div><h2>Desempenho da frota</h2><p>Vida útil média dos pneus nos últimos 6 meses</p></div><select class="form-select form-select-sm chart-select" aria-label="Período"><option>Últimos 6 meses</option></select></header><div class="card-body pt-0"><div class="performance-chart"><div class="chart-labels"><span>100%</span><span>75%</span><span>50%</span><span>25%</span><span>0%</span></div><div class="chart-area"><svg viewBox="0 0 680 220" preserveAspectRatio="none" role="img" aria-label="Gráfico de evolução da vida útil média"><defs><linearGradient id="area" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#b7d84b" stop-opacity=".35"/><stop offset="100%" stop-color="#b7d84b" stop-opacity="0"/></linearGradient></defs><path class="chart-grid" d="M0 0H680M0 55H680M0 110H680M0 165H680M0 220H680"/><path d="M0 162 C42 155 64 144 104 147 S165 130 210 136 S271 112 315 118 S379 83 420 97 S484 78 525 81 S590 48 632 58 S663 42 680 35 L680 220 L0 220Z" fill="url(#area)"/><path class="chart-line" d="M0 162 C42 155 64 144 104 147 S165 130 210 136 S271 112 315 118 S379 83 420 97 S484 78 525 81 S590 48 632 58 S663 42 680 35"/><circle cx="525" cy="81" r="5" class="chart-point"/></svg><div class="chart-months"><span>Mar</span><span>Abr</span><span>Mai</span><span>Jun</span><span>Jul</span><span>Ago</span></div></div></div></div></article></div>
<div class="col-xl-4"><article class="card dashboard-card h-100"><header class="card-header bg-white border-0"><h2>Alertas recentes</h2><p>Itens que precisam da sua atenção</p></header><div class="card-body pt-0"><div class="alert-item"><span class="alert-icon alert-danger"><i class="bi bi-exclamation-triangle"></i></span><div><strong>Inspeção vencida</strong><p>Veículo ABC-1234</p></div><a href="#" aria-label="Ver inspeção"><i class="bi bi-chevron-right"></i></a></div><div class="alert-item"><span class="alert-icon alert-warning"><i class="bi bi-disc"></i></span><div><strong>Baixa profundidade</strong><p>Pneu #TR-9082 · 2,1 mm</p></div><a href="#" aria-label="Ver pneu"><i class="bi bi-chevron-right"></i></a></div><div class="alert-item"><span class="alert-icon alert-info"><i class="bi bi-calendar-event"></i></span><div><strong>Rodízio programado</strong><p>Em 3 veículos esta semana</p></div><a href="#" aria-label="Ver programação"><i class="bi bi-chevron-right"></i></a></div><a class="view-all" href="#">Ver todos os alertas <i class="bi bi-arrow-right"></i></a></div></article></div></section>

