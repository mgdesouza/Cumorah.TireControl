@page
@model LoginModel
@{ ViewData["Title"] = "Entrar"; }
<section class="login-card">
    <a asp-page="/Index" class="login-brand" aria-label="TireControl, página inicial"><span class="brand-symbol"><i class="bi bi-circle-fill"></i></span><span>Tire<span class="text-success">Control</span></span></a>
    <header><h1>Boas-vindas de volta</h1><p>Acesse sua plataforma para gerir a frota.</p></header>
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
        <div class="mb-3"><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="nome@empresa.com" /><span asp-validation-for="Input.Email" class="text-danger small"></span></div>
        <div class="mb-3"><div class="d-flex justify-content-between"><label asp-for="Input.Password" class="form-label">Senha</label><a href="#" class="small text-success">Esqueci minha senha</a></div><input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Digite sua senha" /><span asp-validation-for="Input.Password" class="text-danger small"></span></div>
        <div class="form-check mb-4"><input asp-for="Input.RememberMe" class="form-check-input" /><label asp-for="Input.RememberMe" class="form-check-label text-secondary">Manter-me conectado</label></div>
        <button class="btn btn-tirecontrol w-100" type="submit">Entrar na plataforma <i class="bi bi-arrow-right ms-2"></i></button>
    </form>
    <p class="login-help">Precisa de ajuda? <a href="mailto:suporte@tirecontrol.com">Fale com o suporte</a></p>
</section>
